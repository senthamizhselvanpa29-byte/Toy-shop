# Copy this file to .env.local and fill in the values.
# Supabase → Project Settings → API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Customer login options (email codes always work):
# NEXT_PUBLIC_LOGIN_PHONE=1   # mobile OTP — needs an SMS provider set up in Supabase
# NEXT_PUBLIC_LOGIN_GOOGLE=1  # "Continue with Google" — needs Google set up in Supabase

# Razorpay keys are added in Milestone 8.
